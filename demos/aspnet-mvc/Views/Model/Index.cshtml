@model IEnumerable<CarModel>

<section class="space-y-6">
    <div class="flex flex-col gap-4 border-b border-slate-200 pb-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <p class="text-sm font-semibold text-emerald-700">Catalog</p>
            <h1 class="mt-2 text-3xl font-bold text-slate-950">Models</h1>
            <p class="mt-2 text-sm text-slate-600">Define rental pricing, seating, and fuel data for every model.</p>
        </div>
        <a asp-action="Create" class="inline-flex w-fit items-center justify-center rounded-md bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2">Create model</a>
    </div>

    <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm">
        <table class="min-w-full divide-y divide-slate-200 text-sm">
            <thead class="bg-slate-950 text-left text-white">
                <tr>
                    <th class="px-4 py-3 font-semibold">Name</th>
                    <th class="px-4 py-3 font-semibold">Brand</th>
                    <th class="px-4 py-3 font-semibold">Daily price</th>
                    <th class="px-4 py-3 font-semibold">Seats</th>
                    <th class="px-4 py-3 font-semibold">Fuel</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var carModel in Model)
                {
                    <tr class="transition hover:bg-stone-50">
                        <td class="px-4 py-3 font-semibold text-slate-950">@carModel.Name</td>
                        <td class="px-4 py-3 text-slate-700">@carModel.CarBrand.Name</td>
                        <td class="whitespace-nowrap px-4 py-3 text-slate-700">@carModel.DailyPrice</td>
                        <td class="px-4 py-3 text-slate-700">@carModel.NbSeats</td>
                        <td class="px-4 py-3 text-slate-700">@carModel.Fuel</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
