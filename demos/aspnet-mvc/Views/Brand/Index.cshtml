@model IEnumerable<CarBrand>

<section class="space-y-6">
    <div class="flex flex-col gap-4 border-b border-slate-200 pb-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <p class="text-sm font-semibold text-emerald-700">Catalog</p>
            <h1 class="mt-2 text-3xl font-bold text-slate-950">Brands</h1>
            <p class="mt-2 text-sm text-slate-600">Manage manufacturer names available for car models.</p>
        </div>
        <a asp-action="Create" class="inline-flex w-fit items-center justify-center rounded-md bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2">Create brand</a>
    </div>

    <div class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
        <table class="min-w-full divide-y divide-slate-200 text-sm">
            <thead class="bg-slate-950 text-left text-white">
                <tr>
                    <th class="px-4 py-3 font-semibold">Name</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var brand in Model)
                {
                    <tr class="transition hover:bg-stone-50">
                        <td class="px-4 py-3 font-medium text-slate-800">@brand.Name</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
